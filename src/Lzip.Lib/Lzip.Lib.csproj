<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SharpAstro.Lzip</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <!-- AssemblyVersion is major.minor.0.0, DERIVED from the one place the number is written
         (VersionMajorMinor in the repo-root Directory.Build.props), which also supplies
         VersionPrefix. The NuGet package version is composed in CI via
         $(VERSION_PREFIX)$(VERSION_REV)+$(VERSION_HASH), whose prefix is read back from that same
         property. Bump it THERE; do not restate it here. -->
    <AssemblyVersion>$(VersionMajorMinor).0.0</AssemblyVersion>
    <PackageId>Lzip.Lib</PackageId>
    <Description>Pure-managed lzip (LZMA1) codec: a fast, AOT/trim-friendly compressor and decompressor for the lzip container format, including multi-member files with parallel decode and -b-style member splitting. Output is read by the reference lzip binary. No external lzip binary required.</Description>
    <PackageTags>lzip;lzma;lzma1;compression;decompression;codec;aot</PackageTags>
    <Authors>Sebastian Godelet</Authors>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/SharpAstro/Lzip.Lib.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lzip.Lib.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
