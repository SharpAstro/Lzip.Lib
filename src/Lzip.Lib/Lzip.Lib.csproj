<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SharpAstro.Lzip</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <!-- AssemblyVersion fixed at major.minor.0.0; the NuGet package version is composed in
         CI via $(VERSION_PREFIX)$(VERSION_REV)+$(VERSION_HASH). Bump VersionPrefix here on
         minor feature additions / breaking changes; CI's run_number drives the patch. -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <PackageId>Lzip.Lib</PackageId>
    <Description>Pure-managed lzip (LZMA1) codec: a fast, AOT/trim-friendly decompressor for the lzip container format, including multi-member files with parallel decode. Decoder only in 1.0; an encoder follows. No external lzip binary required.</Description>
    <PackageTags>lzip;lzma;lzma1;compression;decompression;codec;aot</PackageTags>
    <Authors>Sebastian Godelet</Authors>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/SharpAstro/Lzip.Lib.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lzip.Lib.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
